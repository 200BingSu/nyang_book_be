<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nyangbook.nyangbook.components.search.SearchMapper">
    <sql id="productJoin">
        LEFT JOIN brand b
            ON p.brand_key = b.brand_key
        LEFT JOIN product_attributes pa
            ON p.attributes_key = pa.attributes_key
        LEFT JOIN product_taste pt
            ON p.taste_key = pt.taste_key
        LEFT JOIN product_type t
            ON p.type_key = t.type_key
    </sql>
    <select id="selectData" parameterType="map" resultType="map">
        <choose>
            <when test = "query == 'purchases'">
                SELECT *
                FROM public.purchases pu
                LEFT JOIN public.product p ON p.product_key = pu.product_key
                <include refid="productJoin" />
                <if test="key != null and key != 0 and key != ''">
                    AND ${query}_key = #{key}
                </if>
                <choose>
                    <when test="orderBy != null and orderBy.size() > 0">
                        ORDER BY
                        <foreach collection="orderBy" item="item" separator=",">
                            <choose>
                                <when test="item.orderBy == 'brand_name'">b.${item.orderBy} ${item.sortOrder}</when>
                                <when test="item.orderBy == 'product_name'">p.${item.orderBy} ${item.sortOrder}</when>
                                <otherwise>
                                    <if test="item.orderBy != 'index'">
                                        pu.${item.orderBy} ${item.sortOrder}
                                    </if>
                                </otherwise>
                            </choose>
                        </foreach>
                    </when>
                    <otherwise>
                        ORDER BY pu.created_at DESC
                    </otherwise>
                </choose>
            </when>
            <otherwise>
                SELECT *, TO_CHAR(created_at, 'YY-MM-DD') AS fm_created_at
                FROM ${query}
                WHERE 1=1
                <if test="key != null and key != 0 and key != ''">
                    AND ${query}_key = #{key}
                </if>
                <choose>
                    <when test="orderBy != null and orderBy.size() > 0">
                        ORDER BY
                        <foreach collection="orderBy" item="item" separator=",">
                            <if test="item.orderBy != 'index'">
                                ${item.orderBy} ${item.sortOrder}
                            </if>
                        </foreach>
                    </when>
                    <otherwise>
                        ORDER BY created_at DESC
                    </otherwise>
                </choose>
            </otherwise>
        </choose>
    </select>
</mapper>
